# Local development uses a SQLite file. On Vercel, point this at a Turso database.
DATABASE_URL=file:local.db
# Only needed for Turso (leave empty for the local file).
DATABASE_AUTH_TOKEN=
# Any long random string. Sessions are signed with it. Generate one with: openssl rand -base64 32
AUTH_SECRET=change-me-to-a-long-random-string
